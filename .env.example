# Application Settings
APP_NAME="CareNest - Elderly Care & Medication Management"
ENVIRONMENT=development
PORT=8080
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars

# Database
DATABASE_URL=sqlite:///./healthapp.db

# Cron/Scheduler Secret Token for /tasks/send-reminders (e.g. Render Cron, Cloud Scheduler, GitHub Actions)
# Header required: X-Scheduler-Token: <SCHEDULER_SECRET_TOKEN>
SCHEDULER_SECRET_TOKEN=scheduler-super-secret-token-change-in-prod

# Google Gemini API Key
GEMINI_API_KEY=

# SMTP Email Configuration (Optional - falls back to safe console logging in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CareNest Alerts <alerts@carenest.local>"
SMTP_TLS=true
